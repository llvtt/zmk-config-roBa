#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;
    // scroll-layers = <5>;
    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 11>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        single_quote {
            bindings = <&kp SQT>;
            key-positions = <20 19>;
        };

        shift_ctrl {
            bindings = <&kp LS(LEFT_CONTROL)>;
            key-positions = <10 22>;
        };

        symbols_lhs {
            bindings = <&mo 2>;
            key-positions = <12 13>;
        };

        symbols_rhs {
            bindings = <&mo 2>;
            key-positions = <18 19>;
        };

        cmd_num_rhs {
            bindings = <&mod_layer 5 RIGHT_COMMAND>;
            key-positions = <33 32>;
        };

        cmd_num_lhs {
            bindings = <&mod_layer 5 LEFT_COMMAND>;
            key-positions = <22 23>;
        };

        shift_cmd_rhs {
            bindings = <&kp RS(RIGHT_COMMAND)>;
            key-positions = <41 21>;
        };

        cmd_sym_rhs {
            bindings = <&mod_layer 2 RIGHT_COMMAND>;
            key-positions = <33 31>;
        };

        cmd_sym_lhs {
            bindings = <&mod_layer 2 LEFT_COMMAND>;
            key-positions = <22 24>;
        };

        one {
            bindings = <&kp NUMBER_1>;
            key-positions = <0 1>;
        };

        two {
            bindings = <&kp NUMBER_2>;
            key-positions = <1 2>;
        };

        three {
            bindings = <&kp NUMBER_3>;
            key-positions = <2 3>;
        };

        four {
            bindings = <&kp NUMBER_4>;
            key-positions = <3 4>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <30 31>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <29 30>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        dblclick: dblclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1>, <&macro_wait_time 100>, <&mkp MB1>;

            label = "DBLCLICK";
        };

        tripleclick: tripleclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mkp MB1>,
                <&macro_wait_time 100>,
                <&mkp MB1>,
                <&macro_wait_time 100>,
                <&mkp MB1>;

            label = "TRIPLECLICK";
        };

        mod_layer: mod_layer {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        tap_repeat: tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_REPEAT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };

        encoder_kp: encoder_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_KP";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        tap_repeat_hold_layer: tap_repeat_hold_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_REPEAT_HOLD_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };

        encoder_mouse_scroll: encoder_mouse_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MOUSE_SCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(-80)>, <&msc MOVE_Y(80)>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                     &kp W    &kp E                       &kp R                               &kp T                                                                                            &kp Y                           &kp U                      &kp I                           &kp O    &kp P
&lt 3 A                   &kp S    &kp D                       &kp F                               &kp G                            &kp C_MUTE                        &kp RCTRL                     &kp H                           &kp J                      &kp K                           &kp L    &tap_repeat RIGHT_COMMAND SEMICOLON
&tap_repeat LEFT_SHIFT Z  &kp X    &tap_repeat_hold_layer 1 C  &mt LEFT_SHIFT V                    &kp B                            &tap_repeat_hold_layer 5 TAB      &tap_repeat_hold_layer 5 TAB  &kp N                           &tap_repeat RIGHT_SHIFT M  &tap_repeat_hold_layer 1 COMMA  &kp DOT  &tap_repeat RIGHT_SHIFT SLASH
&caps_word                &kp SQT  &kp GRAVE                   &tap_repeat LEFT_CONTROL BACKSPACE  &tap_repeat LEFT_COMMAND DELETE  &lt 4 ESCAPE                      &tap_repeat LEFT_ALT ENTER    &tap_repeat_hold_layer 5 SPACE                                                                      &mo 6
            >;

            sensor-bindings = <&encoder_mouse_scroll>;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &kp F6      &kp F7  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        SYMBOLS {
            bindings = <
&kp TILDE        &kp AT_SIGN  &kp HASH          &kp DOLLAR         &kp PERCENT                            &kp AMPERSAND  &kp UNDERSCORE        &kp MINUS              &kp PIPE       &kp DOUBLE_QUOTES
&kp EXCLAMATION  &kp PLUS     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp CARET    &trans      &kp ASTERISK  &kp DOLLAR     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &kp SINGLE_QUOTE
&kp GRAVE        &kp TILDE    &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans       &trans      &trans        &trans         &trans                &kp ASTERISK           &trans         &trans
&trans           &trans       &trans            &trans             &trans       &trans      &trans        &trans                                                                     &trans
            >;

            sensor-bindings = <&encoder_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans          &kp UP_ARROW    &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp PAGE_UP     &trans          &kp PAGE_DOWN    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &tripleclick                      &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB2  &mkp MB3  &mkp MB1  &dblclick     &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans    &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans    &trans        &trans      &trans  &trans                          &trans
            >;
        };

        NUMBERS {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans      &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        KBD_CTRL {
            bindings = <
&bl BL_TOG  &trans        &kp C_PREV    &kp C_NEXT    &kp C_PLAY_PAUSE                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans      &trans        &trans        &trans        &trans            &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans            &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans      &trans        &trans        &trans        &trans            &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&encoder_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        math {
            bindings = <
&tog 7  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans      &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
